-- Display just name and role
SELECT name, role
FROM suspects;
-- Display seen in Cafeteria
SELECT * FROM suspects
WHERE last_seen_place= 'Cafeteria';
-- Display students only
SELECT name
FROM suspects
WHERE role = 'Student';
-- Display with no alibi
SELECT name
FROM suspects
WHERE alibi IS NULL;
-- Display whose alibi mentions cooking 
SELECT name, alibi
 FROM suspects
WHERE alibi LIKE 'Cooking since 5am%';
-- Display lecturers or security
SELECT name, role
FROM suspects
WHERE role IN ('Lecturer', 'Security');
-- Display 3 earliest sightings
SELECT name, last_seen_place, time_seen
FROM suspects
ORDER BY time_seen ASC
LIMIT 3;
-- List each place in the file once
SELECT DISTINCT last_seen_place
FROM suspects;










