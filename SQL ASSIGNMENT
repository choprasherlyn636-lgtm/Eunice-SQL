DROP TABLE IF EXISTS suspects;
CREATE TABLE suspects(
  suspect_id INTEGER PRIMARY KEY,
  name VARCHAR(30) NOT NULL,
  role VARCHAR(20),
  last_seen_place VARCHAR(20),
  time_seen VARCHAR(10),
  carrying VARCHAR(20),
  shoe_size INTEGER,
  alibi VARCHAR(40),
  status VARCHAR(15) DEFAULT'suspects'
);
